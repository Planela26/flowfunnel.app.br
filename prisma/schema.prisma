generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  publicId               String?   @unique // FLS-XXXXXX — ID da Conta exibido ao usuário
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  role                   String    @default("PRODUTOR")
  plan                   String    @default("FREE")
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  alertSettings          String?   // JSON com toggles de alertas automáticos
  funnelLayout           String?   // JSON com posições dos cards do FunnelFlow (sincroniza entre navegadores)
  funnelVisibleIds       String?   // JSON com IDs dos cards que o usuário deixou visíveis; null = ainda não escolheu (mostra tudo)
  metaPurchase           String?   // JSON com Purchase pendente p/ disparo do Pixel (read-once na success page)
  onboardingCompletedAt  DateTime?
  trialEndsAt            DateTime?
  trialPlan              String?
  trialStatus            String?   @default("none")
  trialStartedAt         DateTime?
  trialPromptSeenAt      DateTime? // primeira vez que o usuário viu o modal "Ative seu teste grátis"; usado para mostrar 1x só
  paymentMethodAddedAt   DateTime?
  trialPaymentFingerprint String?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?   // secret TOTP criptografado (AES-256-GCM)
  twoFactorActivatedAt   DateTime?
  subscriptionStatus     String?   // 'active' | 'past_due' | 'cancelled' | 'expired' | null
  gracePeriodEndsAt      DateTime? // 3 dias após primeira falha de pagamento
  sessionVersion         Int       @default(0) // incrementado ao trocar email/senha → invalida todos os JWTs anteriores
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  accounts             Account[]
  funnels              Funnel[]
  integrations         Integration[]
  goals                Goal[]
  notifications        Notification[]
  webhookLogs          WebhookLog[]
  campaigns            Campaign[]
  workspaces           Workspace[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeCodes      EmailChangeCode[]
  teamMemberships      TeamMember[]
  leadStatuses         LeadStatus[]
  affiliateProfile     Affiliate?               @relation("AffiliateOwner")
  referredByAffiliateId String?                 // congelado na primeira conversão paga — nunca reescrito pelo cliente (AFFILIATE_WALLET_ARCHITECTURE.md §18.7)
  referredByAffiliate  Affiliate?               @relation("AffiliateReferral", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  trackedLeads         TrackedLead[]
  trackedEvents        TrackedEvent[]
  trackedConversions   TrackedConversion[]
  trackedSessions      TrackedSession[]
  saleAttributions     SaleAttribution[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  supportTickets       SupportTicket[]
}

model TwoFactorRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// Código numérico enviado para o email ATUAL antes de permitir trocar.
// Prova que o dono da conta controla o email atual. Curta duração + 1 uso.
model EmailChangeCode {
  id          String   @id @default(cuid())
  userId      String
  codeHash    String   @unique
  pendingEmail String  // novo email solicitado (ainda não aplicado)
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MetricSnapshot {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime // Data normalizada para 00:00:00 UTC
  vendas        Int      @default(0)
  receita       Float    @default(0)
  checkouts    Int      @default(0)
  conversas    Int      @default(0)
  leads         Int      @default(0)
  reembolsos    Int      @default(0)
  recusados     Int      @default(0)
  abandonos     Int      @default(0)
  gasto         Float    @default(0) // Gasto agregado em mídia (Meta/Google/TikTok) no dia
  metadata      String?  // JSON livre para extensões futuras
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Funnel {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages FunnelStage[]
  events FunnelEvent[]

  @@index([userId])
}

model FunnelStage {
  id          String   @id @default(cuid())
  funnelId    String
  name        String
  order       Int
  description String?
  
  funnel Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  events FunnelEvent[]
  
  @@unique([funnelId, order])
}

model FunnelEvent {
  id            String   @id @default(cuid())
  funnelId      String
  stageId       String
  leadId        String?
  eventType     String
  source        String?  // 'hotmart', 'kiwify', 'eduzz', 'monetizze', 'perfect_pay', etc.
  transactionId String?  // ID da transação na plataforma (ex: Hotmart purchase.transaction)
  metadata      String?
  timestamp     DateTime @default(now())

  funnel Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stage  FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([funnelId, source, transactionId], name: "idx_funnel_event_dedup")
  @@index([funnelId, timestamp])
  @@index([stageId])
  @@index([timestamp])
}

model Integration {
  id           String          @id @default(cuid())
  userId       String
  platform     String
  nickname     String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  isActive     Boolean         @default(true)
  isDefault    Boolean         @default(false)
  config       String?
  webhookToken String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([webhookToken])
}

model StripeProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String?
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model MercadoPagoProcessedEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model Goal {
  id             String    @id @default(cuid())
  userId         String
  title          String
  description    String?
  targetValue    Float
  currentValue   Float     @default(0)
  metric         String    // 'sales', 'revenue', 'leads', 'conversions', 'clicks'
  platform       String?   // 'ALL', 'WHATSAPP', 'META_ADS', 'HOTMART'
  startDate      DateTime  @default(now())
  endDate        DateTime
  isActive       Boolean   @default(true)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  notified       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'goal_completed', 'alert', 'info', 'warning'
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model WebhookLog {
  id          String   @id @default(cuid())
  userId      String
  platform    String   // 'WHATSAPP', 'HOTMART', 'META_ADS'
  event       String   // Tipo do evento recebido
  method      String   // GET, POST, etc
  endpoint    String   // URL do webhook
  headers     String?  // JSON dos headers
  payload     String?  // JSON do payload recebido
  response    String?  // Resposta enviada
  statusCode  Int      @default(200)
  duration    Int?     // Duração do processamento em ms
  error       String?  // Mensagem de erro se houver
  requestId   String?  // Correlation ID (X-Request-ID) para tracing end-to-end
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([platform])
  @@index([event])
  @@index([createdAt])
  @@index([statusCode])
}

model Workspace {
  id                    String   @id @default(cuid())
  publicId              String?  @unique // WKS-XXXXXX
  userId                String
  name                  String
  emoji                 String   @default("🚀")
  isDefault             Boolean  @default(false)
  whatsappIntegrationId String?
  facebookCampaignId    String?
  checkoutSources       String   @default("[\"hotmart\"]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

// ── Carteira financeira de afiliados ────────────────────────────────────────
// Desenho completo, decisões de negócio e revisão adversarial em
// AFFILIATE_WALLET_ARCHITECTURE.md. Enums e models abaixo implementam a
// Seção 24 (IMPLEMENTATION SPECIFICATION) desse documento.

enum AffiliateStatus {
  ACTIVE
  BLOCKED
}

enum PaymentProcessor {
  STRIPE
  MERCADOPAGO
}

enum SaleType {
  INITIAL
  RENEWAL
}

enum CommissionStatus {
  PENDING   // dentro da janela de retenção (15 dias — Decisão D)
  AVAILABLE // amadurecida, fundida ao saldo agregado da carteira
  REVERSED  // estornada (refund/chargeback)
}

enum LedgerAccount {
  PENDING
  AVAILABLE
  RESERVED
}

enum LedgerEntryType {
  COMMISSION_ACCRUE
  COMMISSION_MATURE
  COMMISSION_REVERSE
  PAYOUT_RESERVE
  PAYOUT_RELEASE
  PAYOUT_SETTLE
  ADJUSTMENT
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  FAILED
  CANCELLED
  REJECTED
}

model Affiliate {
  id                String          @id @default(cuid())
  name              String
  email             String?
  code              String          @unique
  discountPercent   Decimal         @db.Decimal(5, 2)
  commissionPercent Decimal         @db.Decimal(5, 2)
  stripeCouponId    String?
  status            AffiliateStatus @default(ACTIVE)
  userId            String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user          User?                  @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: SetNull)
  referredUsers User[]                 @relation("AffiliateReferral")
  clicks        AffiliateClick[]
  sales         AffiliateSale[]
  commissions   AffiliateCommission[]
  ledgerEntries AffiliateLedgerEntry[]
  wallet        AffiliateWallet?
  payouts       AffiliatePayout[]

  @@index([code])
  @@index([status])
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade) // não financeiro — cascade OK

  @@index([affiliateId])
  @@index([createdAt])
}

// PAUSADO — redesenho completo aguarda confirmação sobre dados históricos
// (ver AFFILIATE_WALLET_ARCHITECTURE.md §24.1 / mensagem de acompanhamento).
// Nesta etapa só foi adicionada a relação reversa com AffiliateCommission e
// trocado onDelete de Cascade para Restrict (achado §0.3 — nenhum dos dois
// exige migração de dados existentes). `stripePaymentId`, `plan`,
// `originalAmount`/`discountedAmount` (ainda Float) e `commissionAmount`
// permanecem intactos até a decisão sobre o histórico.
model AffiliateSale {
  id               String    @id @default(cuid())
  affiliateId      String
  userId           String?
  stripePaymentId  String    @unique
  plan             String
  originalAmount   Float
  discountedAmount Float
  commissionAmount Float
  createdAt        DateTime  @default(now())

  affiliate  Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  commission AffiliateCommission?

  @@index([affiliateId])
  @@index([createdAt])
}

model AffiliateCommission {
  id                        String           @id @default(cuid())
  saleId                    String           @unique
  affiliateId               String
  amount                    Decimal          @db.Decimal(12, 2)
  commissionPercentSnapshot Decimal          @db.Decimal(5, 2)
  status                    CommissionStatus @default(PENDING)
  maturesAt                 DateTime
  createdAt                 DateTime         @default(now())

  sale          AffiliateSale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  affiliate     Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  ledgerEntries AffiliateLedgerEntry[]

  @@index([affiliateId, status])
  @@index([maturesAt])
}

model AffiliateLedgerEntry {
  id              String          @id @default(cuid())
  affiliateId     String
  account         LedgerAccount
  amount          Decimal         @db.Decimal(12, 2)
  type            LedgerEntryType
  transferGroupId String?
  commissionId    String?
  payoutId        String?
  idempotencyKey  String          @unique
  reason          String?
  createdBy       String?
  createdAt       DateTime        @default(now())

  affiliate  Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  commission AffiliateCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  payout     AffiliatePayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
  @@index([commissionId])
  @@index([payoutId])
}

model AffiliateWallet {
  affiliateId      String   @id
  pendingBalance   Decimal  @db.Decimal(12, 2) @default(0)
  availableBalance Decimal  @db.Decimal(12, 2) @default(0)
  reservedBalance  Decimal  @db.Decimal(12, 2) @default(0)
  lifetimeEarned   Decimal  @db.Decimal(12, 2) @default(0)
  lifetimePaid     Decimal  @db.Decimal(12, 2) @default(0)
  updatedAt        DateTime @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
}

model AffiliatePayout {
  id             String       @id @default(cuid())
  affiliateId    String
  amount         Decimal      @db.Decimal(12, 2)
  pixKey         String
  status         PayoutStatus @default(REQUESTED)
  idempotencyKey String
  requestedAt    DateTime     @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  paidAt         DateTime?
  failureReason  String?
  adminNote      String?

  affiliate     Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  ledgerEntries AffiliateLedgerEntry[]

  @@unique([affiliateId, idempotencyKey])
  @@index([affiliateId, status])
}

model Campaign {
  id                String   @id @default(cuid())
  userId            String
  platform          String   // 'META_ADS', 'WHATSAPP', 'HOTMART'
  campaignId        String   // ID da campanha na plataforma (ex: Facebook Campaign ID)
  name              String
  status            String   // 'ACTIVE', 'PAUSED', 'ARCHIVED'
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false) // Campanha padrão exibida no dashboard
  objective         String?  // Objetivo da campanha (CONVERSIONS, TRAFFIC, etc)
  startDate         DateTime?
  endDate           DateTime?
  budget            Float?   // Orçamento configurado
  spend             Float    @default(0) // Gasto atual
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, platform, campaignId])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([isDefault])
}

model TeamMember {
  id        String   @id @default(cuid())
  publicId  String?  @unique // INV-XXXXXX — ID do convite
  ownerId   String
  email     String
  name      String?
  role      String   @default("VIEWER")
  status    String   @default("PENDING")
  token     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, email])
  @@index([ownerId])
  @@index([token])
}

model LeadStatus {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  name      String?
  email     String?
  stage     String   @default("NOVO")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
  @@index([stage])
}

model TrackedLead {
  id          String   @id @default(cuid())
  userId      String
  leadId      String
  visitorId   String?  // id do navegador — pode ter vários leadIds ao longo do tempo
  utmSource   String?
  utmCampaign String?
  utmMedium   String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?  // Meta click ID
  gclid       String?  // Google click ID
  ttclid      String?  // TikTok click ID
  msclkid     String?  // Microsoft click ID
  firstUrl    String?
  referrer    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId])
  @@index([userId])
  @@index([leadId])
  @@index([visitorId])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([createdAt])
}

// Sessão de visita: agrupa eventos de uma mesma jornada (janela de 30min de
// inatividade encerra a sessão no tracker). Um visitorId pode ter N sessões.
model TrackedSession {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  visitorId String?
  leadId    String
  firstUrl  String?
  referrer  String?
  startedAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId, leadId])
  @@index([visitorId])
  @@index([startedAt])
}

// Vínculo explícito venda ↔ lead rastreado. method indica a estratégia usada:
// 'deterministic' (lead_id devolvido pelo checkout/thank-you page) tem
// prioridade absoluta; 'probabilistic' (email/telefone/janela temporal) é
// fallback e nunca sobrescreve um vínculo determinístico existente.
model SaleAttribution {
  id            String   @id @default(cuid())
  userId        String
  platform      String   // hotmart | kiwify | eduzz | monetizze | perfect_pay | stripe | tracker
  transactionId String   // id da transação na plataforma de origem (ou orderId)
  leadId        String?  // TrackedLead.leadId quando resolvido
  method        String   // 'deterministic' | 'probabilistic' | 'unmatched'
  matchedBy     String?  // 'checkout_param' | 'thank_you_page' | 'email' | 'phone' | 'time_window' | null
  confidence    Float    @default(0) // 1.0 determinístico; <1 probabilístico
  utmSource     String?  // snapshot da origem no momento da atribuição
  utmCampaign   String?
  utmMedium     String?
  utmContent    String?
  fbclid        String?
  gclid         String?
  value         Float    @default(0)
  currency      String   @default("BRL")
  product       String?
  buyerEmail    String?
  buyerPhone    String?
  metadata      String?  // JSON livre
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, transactionId])
  @@index([userId, createdAt])
  @@index([leadId])
  @@index([method])
}

model TrackedEvent {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  sessionId String?
  eventName String
  url       String?
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([eventName])
  @@index([createdAt])
}

model TrackedConversion {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  orderId   String?  // id do pedido informado pela thank-you page — chave do match determinístico
  platform  String?  // hotmart | kiwify | ... quando informado pela thank-you page
  currency  String   @default("BRL")
  value     Float    @default(0)
  product   String?
  source    String?
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([orderId])
  @@index([createdAt])
}

// Trilha de auditoria de ações sensíveis (autenticação, usuários, cobrança,
// integrações, administração). NUNCA armazenar tokens, senhas ou secrets aqui.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  // multi-tenant: normalmente = userId do dono do recurso
  userId     String?  // ator que executou a ação (null se sistema/anônimo)
  action     String   // ex.: 'auth.login', 'billing.subscription.updated'
  entityType String?  // ex.: 'User', 'Integration', 'Subscription'
  entityId   String?
  ip         String?
  userAgent  String?
  result     String   @default("success") // 'success' | 'failure'
  metadata   String?  // JSON livre, já sanitizado (sem segredos)
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// Proteção anti-replay de webhooks. A coluna `signature` guarda um fingerprint
// (hash sha256 de plataforma + assinatura ou do raw body) — não a assinatura
// original. Unicidade (platform, signature) detecta reenvio atomicamente.
model WebhookReplayProtection {
  id        String    @id @default(cuid())
  platform  String
  signature String
  timestamp DateTime?
  createdAt DateTime  @default(now())

  @@unique([platform, signature])
  @@index([createdAt])
}

// Rate limiting distribuído (persistente em Postgres) — substitui o Map
// em memória que não funcionava entre instâncias/restarts.
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SARA.AI — MEMÓRIA, INSIGHTS E OBSERVADOR
// ─────────────────────────────────────────────────────────────────────────────

// Memória de longo prazo da Sara — preferências, objetivos, observações, decisões.
// type: 'preference' | 'goal' | 'observation' | 'decision'
model SaraMemory {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'preference' | 'goal' | 'observation' | 'decision'
  content   String
  context   String?  // página/módulo onde a memória foi criada
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

// Insights proativos gerados pela Sara.AI e pelo SaraObserver.
// severity: 'info' | 'warning' | 'critical'
// type: 'webhook_failed' | 'integration_disconnected' | 'campaign_drop' | 'funnel_abandonment_spike'
//       | 'payment_rejected' | 'metric_anomaly' | 'ticket_spike' | 'high_error_rate'
model SaraInsight {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  severity    String   @default("info")
  isRead      Boolean  @default(false)
  data        String?  // JSON com payload adicional
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────────────────────
// SARA.AI — LOGS DE IA
// ─────────────────────────────────────────────────────────────────────────────

// Registro de cada chamada ao modelo de IA — para auditoria, custo e otimização.
// action: 'analyze_ticket' | 'suggest_reply' | 'chat' | 'classify'
model AILog {
  id             String   @id @default(cuid())
  ticketId       String?
  userId         String?
  action         String
  model          String   @default("gpt-4o-mini")
  promptTokens   Int      @default(0)
  completTokens  Int      @default(0)
  totalTokens    Int      @default(0)
  durationMs     Int      @default(0)
  costUsd        Float    @default(0)
  accepted       Boolean? // null = não rastreado, true = admin usou a sugestão
  category       String?  // categoria do ticket analisado
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ─────────────────────────────────────────────────────────────────────────────
// CENTRAL DE SUPORTE
// ─────────────────────────────────────────────────────────────────────────────

// Chamado de suporte aberto por um usuário.
// type:     'bug' | 'suggestion' | 'complaint' | 'question' | 'financial' | 'integration' | 'other'
// priority: 'low' | 'medium' | 'high' | 'critical'
// status:   'new' | 'analyzing' | 'investigating' | 'in_development' | 'waiting_client' | 'resolved' | 'closed'
model SupportTicket {
  id               String    @id @default(cuid())
  publicId         String?   @unique // SUP-XXXXXX — ID público do chamado
  number           Int       @unique @default(autoincrement())
  userId           String
  assigneeId       String?
  subject          String
  description      String
  type             String    @default("question")
  priority         String    @default("medium")
  status           String    @default("new")
  aiSummary        String?   // JSON com análise da Sara.AI
  tags             String?   // JSON array
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]
  notes       SupportInternalNote[]
  history     SupportHistory[]
  attachments SupportAttachment[]

  @@index([userId])
  @@index([publicId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// Mensagens trocadas no ticket (usuário, admin ou Sara.AI).
// senderType: 'user' | 'admin' | 'ai'
model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  senderId   String?  // null = Sara.AI
  senderType String   @default("user")
  content    String
  createdAt  DateTime @default(now())

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId])
}

// Arquivos anexados a um ticket ou a uma mensagem específica.
model SupportAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  messageId String?
  name      String
  url       String
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())

  ticket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

// Notas internas visíveis apenas para administradores.
model SupportInternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Histórico de mudanças no ticket (status, prioridade, atribuição, etc.).
// action: 'created' | 'status_changed' | 'priority_changed' | 'assigned' | 'closed' | 'reopened'
// actorType: 'user' | 'admin' | 'ai' | 'system'
model SupportHistory {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String?
  actorType String   @default("system")
  action    String
  from      String?
  to        String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Base de conhecimento — artigos usados para alimentar o contexto da Sara.AI.
model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  content   String   // Markdown
  category  String
  tags      String?  // JSON array de strings
  published Boolean  @default(true)
  version   String?  // ex: '1.0', '2.3'
  authorId  String?  // ID do admin que criou
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
}
